# GitHub OAuth App credentials used by /api/auth and /api/callback to let
# Decap CMS (public/cms) commit blog posts to the GitHub repo on your behalf.
# Create the OAuth App at https://github.com/settings/developers
# — Homepage URL: your deployed site URL
# — Authorization callback URL: <your deployed site URL>/api/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Resend API key used by /api/contact to email contact-form submissions.
# Create a key at https://resend.com/api-keys (free tier is enough to start).
RESEND_API_KEY=

# Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=goingwilson@gmail.com

# Sender shown on the email. Resend's shared onboarding@resend.dev domain
# works with no setup but can only send to the account's own verified email
# in some cases — verify a domain in Resend and switch this once you have one.
CONTACT_FROM_EMAIL=PsychMind <onboarding@resend.dev>

# ------------------------------------------------------------------
# App: accounts, provider profiles, billing
# ------------------------------------------------------------------

# Postgres connection string (Supabase → Project settings → Database →
# Connection string, "Transaction pooler"). Leave empty locally to use the
# built-in PGlite database in .data/pglite (no Docker needed).
# After setting it: npm run db:migrate
DATABASE_URL=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL (http://localhost:3000 locally, https://www.psychmind.org in production).
BETTER_AUTH_URL=

# Accounts with these emails become admins once their email is verified.
ADMIN_EMAILS=

# Sender for account emails (verify your domain in Resend first).
EMAIL_FROM=PsychMind <hello@psychmind.org>
# Set to "outbox" to keep emails in the local /dev/mail inbox instead of sending.
EMAIL_TRANSPORT=

# Google sign-in (optional). Google Cloud → APIs & Services → Credentials →
# OAuth client ID (Web). Authorized redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (provider subscriptions). All three are needed to turn billing on.
# - STRIPE_SECRET_KEY: Developers → API keys (use sk_test_… until launch)
# - STRIPE_PRICE_BASE: Product catalog → the monthly "Base plan" price (price_…)
# - STRIPE_WEBHOOK_SECRET: Developers → Webhooks → endpoint
#     <BETTER_AUTH_URL>/api/auth/stripe/webhook  (whsec_…)
#   Events: checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_PRICE_BASE=
STRIPE_WEBHOOK_SECRET=

# Rate limiting across serverless instances (optional locally).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------
# Hosts: the product portal lives on its own subdomain
# ------------------------------------------------------------------
# Portal hostname. Sign-up, log in, onboarding, dashboards and admin are
# served here; marketing pages redirect to the marketing host and vice versa.
# Locally this defaults to "app.localhost" (browsers resolve it to this
# machine), e.g. http://app.localhost:3000/login. Leave empty on preview
# deployments to serve everything from one host.
APP_HOST=app.psychmind.org
# Optional: defaults to www.<APP_HOST without "app.">.
MARKETING_HOST=www.psychmind.org
# Where the portal's logo links back to.
NEXT_PUBLIC_MARKETING_URL=https://www.psychmind.org
# With the split on, BETTER_AUTH_URL must be the portal: https://app.psychmind.org
