# GitHub OAuth App credentials used by /api/auth and /api/callback to let
# Decap CMS (public/admin) commit blog posts to the GitHub repo on your behalf.
# Create the OAuth App at https://github.com/settings/developers
# — Homepage URL: your deployed site URL
# — Authorization callback URL: <your deployed site URL>/api/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
